<robot name="calibration_urdf" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- World: LINK -->
  <link name="world"/>

  <!-- CHESSBOARD -->
  <link name="chessboard">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find ros2_opecalibration)/meshes/objects/chessboard.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find ros2_opecalibration)/meshes/objects/chessboard.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="100.0"/>
      <inertia ixx="1.0" ixy="1.0" ixz="0.1" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </link>
  <joint name="world-chessboard-fixed" type="fixed">
    <parent link="world"/>
    <child link="chessboard"/>

    <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0" />
    
    <!-- sample1 <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0" /> -->
    <!-- sample2 <origin xyz="0.0 -0.2 0.2" rpy="0.0 0.0 0.0" /> -->
    <!-- sample3 <origin xyz="0.0 0.2 0.2" rpy="0.0 0.0 0.0" /> -->
    <!-- sample4 <origin xyz="-0.15 -0.2 0.2" rpy="0.0 0.0 0.0" /> -->
    <!-- sample5 <origin xyz="-0.15 0.0 0.2" rpy="0.0 0.0 0.0" /> -->
    <!-- sample6 <origin xyz="-0.15 0.2 0.2" rpy="0.0 0.0 0.0" /> -->
    <!-- sample7 <origin xyz="0.0 0.0 0.4" rpy="0.0 0.0 0.0" /> -->
    <!-- sample8 <origin xyz="0.0 0.0 0.4" rpy="0.1 0.0 0.0" /> -->
    <!-- sample9 <origin xyz="0.0 0.0 0.4" rpy="-0.1 0.0 0.0" /> -->
    <!-- sample10 <origin xyz="0.0 -0.2 0.2" rpy="-0.25 0.0 0.0" /> -->
    <!-- sample11 <origin xyz="0.0 0.2 0.2" rpy="0.25 0.0 0.0" /> -->

  </joint>

  <!-- CAMERA -->
  <link name="camera_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.25 0.0 1.0" rpy="0 1.23 3.1416"/>
    <parent link="world"/>
    <child link="camera_link"/>
  </joint>

  <!-- PARAMS FOR -> lenovoFHD_gazebo -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <update_rate>30</update_rate>
      <camera name="head">
        <horizontal_fov>1.22</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="camera_controller">
        <robotNamespace/>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera</frameName>
        <hackBaseline>0.07</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>

</robot>